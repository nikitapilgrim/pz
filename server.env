# Server settings (committed defaults, no secrets). Override any line in .env (see .env.example).
# Read by the sknnr/zomboid-dedicated-server entrypoint and by our scripts/*.sh.

# Steam branch of the dedicated server. Empty = "public" = Build 42.21 (there is no "unstable" branch any more).
BETA_BRANCH=

# Names the config files (Server/<SERVER_NAME>.ini ...), the save and the player DB; also the PublicName.
# Changing it later starts a NEW world.
SERVER_NAME=PZViewpoint
ADMIN_USERNAME=admin

# Friends-only: hidden from the server browser, joined by IP:port + password (generated on the first start).
PUBLIC=false
MAX_PLAYERS=6
PVP=true
PAUSE_EMPTY=true

# Memory profile for 8 GB available to Docker (other sizes: see .env.example).
MAX_MEMORY=5g
MIN_MEMORY=1g
JVM_EXTRA_ARGS=-XX:SoftMaxHeapSize=4g

# Ini keys the image writes that Build 42 no longer has (B42 uses AntiCheatSafety, AntiCheatSpeed, ...).
CONFIG_EDITOR_SKIP_KEYS=AntiCheatProtectionType21
INIT_TIMEOUT=180

# World autosave (minutes) and PZ's own zip backups inside the data volume (count, period in minutes).
AUTOSAVE_INTERVAL=15
BACKUPS_COUNT=3
BACKUPS_PERIOD=360

# UDP ports; to change them set GAME_PORT / DIRECT_PORT in .env (docker compose reads the ports from there).
GAME_PORT=16261
DIRECT_PORT=16262
RCON_PORT=27015
STEAM_VAC=true

# Load the ZombieBuddy Java agent on the server: required by Viewpoint 3D RVs on dedicated servers, enables the
# server part of True Ballistics. Runs every Java mod in the list (policy=allow-all).
ZOMBIEBUDDY_SERVER=true

# Drop a starting kit next to every new character whose profession matches a file in config/kits/
# (insurgent.txt -> profession Insurgent). Server-side Lua, players install nothing. false = only the manual pz-kit.
AUTO_KITS=true

# Helicopter flyovers on top of the game's own event (server-side Lua, players install nothing): the game's
# helicopter, drawn by Visible Helicopter Events, flies to a random player between 09:00 and 19:00, on average
# every N in-game days (1.5 = about every 1.5 real hours of play with 1-hour days; 0 = off). Same as the admin
# command /chopper on a timer. Every pass pulls zombies from up to 500 tiles.
HELI_FLYOVER_DAYS=1.5

# Reminder in the chat for everyone (admin command servermsg over RCON): enable the body/animal mods in the main
# menu and restart the game. The first one 10 minutes after the start, then every N minutes (0 = off). The same
# text is in the welcome message (config/server.ini) shown on every login.
SETUP_REMINDER_MINUTES=60

# Map load order: mod maps first, vanilla map last.
MAP_NAMES=SecretBase;InsurgentSpawn;Muldraugh, KY
