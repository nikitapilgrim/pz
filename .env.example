# OPTIONAL overrides. Nothing has to be changed to start the server.
# To change something: copy this file to .env, uncomment the line and edit it, then: docker compose up -d --build
# Defaults live in server.env (settings) and mods.env (mod list). Never commit .env.

# ---- Passwords ----------------------------------------------------------------------------------------------
# Generated on the first start and kept in the data volume. Show them: docker compose run --rm pz-init passwords
#SERVER_PASSWORD=
# The admin password only matters on the very first start (when the admin account is created).
#ADMIN_PASSWORD=

# ---- Memory -------------------------------------------------------------------------------------------------
# Docker Desktop (Windows/macOS) gives Docker HALF of the computer's RAM by default.
#   RAM available to Docker:   4 GB (minimum)    8 GB (default)   12 GB     16 GB
#   MAX_MEMORY                 2048m             5g               8g        10g
#   JVM_EXTRA_ARGS             SoftMax 1600m     SoftMax 4g       6g        8g
#   CONTAINER_MEM_LIMIT        3200m             6500m            10g       13g
#   CONTAINER_MEMSWAP_LIMIT    4200m             7500m            11g       14g
#MAX_MEMORY=5g
#JVM_EXTRA_ARGS=-XX:SoftMaxHeapSize=4g
#CONTAINER_MEM_LIMIT=6500m
#CONTAINER_MEMSWAP_LIMIT=7500m

# ---- Game ---------------------------------------------------------------------------------------------------
#MAX_PLAYERS=6
#PVP=true

# Helicopter flyovers (see server.env), on average every N game days. Fewer hordes: 3, or 0 (off). More: 1.
#HELI_FLYOVER_DAYS=1.5

# Take mods out of the load list for a test without editing mods.env (they stay downloaded), e.g. to check
# whether Dynamic Traits breaks the Insurgent loadout traits. Apply with: docker compose up -d
#MODS_DISABLED=DynamicTraits;MoodleFramework

# Viewpoint add-on set. auto (default): while the downloaded Viewpoint is 0.1.6.x the server loads QOL's legacy
# sub-mod and Isometric No More; from Viewpoint 0.1.7 on it loads the main QOL and drops Isometric No More (built into
# 0.1.7). The switch happens on the restart after Viewpoint updates. legacy / current force one set.
#VIEWPOINT_COMPAT=auto

# ---- Ports (UDP); open the same ones in the firewall / router ------------------------------------------------
#GAME_PORT=16261
#DIRECT_PORT=16262
